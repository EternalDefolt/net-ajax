@page
@model IndexModel
@{
    ViewData["Title"] = "Заявка";
}

<h1>Заявка</h1>

@if (Model.Submitted)
{
    <div class="alert alert-success" role="alert">
        Заявка успешно отправлена!
    </div>

    <h2>Анкета</h2>
    <table class="table">
        <tbody>
            <tr><th>ФИО</th><td>@Model.FullName</td></tr>
            <tr><th>Возраст</th><td>@Model.Age</td></tr>
            <tr><th>Email</th><td>@Model.Email</td></tr>
            <tr><th>Телефон</th><td>@Model.Phone</td></tr>
            <tr><th>Город</th><td>@Model.City</td></tr>
            <tr><th>О себе</th><td>@Model.About</td></tr>
        </tbody>
    </table>

    <a class="btn btn-secondary" href="/">Новая заявка</a>
}
else
{
    <p>Заполните заявку, после отправки покажется анкета.</p>

    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">ФИО</label>
            <input asp-for="FullName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Возраст</label>
            <input asp-for="Age" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Телефон</label>
            <input asp-for="Phone" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Город</label>
            <input asp-for="City" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">О себе</label>
            <textarea asp-for="About" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Отправить заявку</button>
    </form>
}
